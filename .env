# local dev prod
ENV="PROD"

# HTTPServer
SERVER_PORT="3003"

# DB SETTINGS
SSL=disable

# DB MASTER
DB_DRIVER_MASTER="postgres"
DB_HOST_MASTER="postgres_master.shared"
DB_HOST_MASTER_DEV="localhost"
DB_NAME_MASTER="postgres"
DB_CONTAINER_MASTER="postgres_socnet"
DB_OPTION_MASTER="sslmode=disable"
DB_PORT_MASTER="5433"
DB_USER_MASTER="postgres"
DB_PASSWORD_MASTER="pass"

# GRPC SERVER ADDRESS
GRPC_SERVER_ADDRESS=event-getaway.shared:50051
GRPC_SERVER_ADDRESS_DEV=localhost:50051 # при разработке можно использоваться другой адрес
